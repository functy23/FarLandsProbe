{
  "text.autoconfig.farlandsprobe.title": "FarLandsProbe 设置",
  "text.autoconfig.farlandsprobe.category.lighting": "光照",
  "text.autoconfig.farlandsprobe.category.border": "世界边境",
  "text.autoconfig.farlandsprobe.category.bounds": "生成与传送边界",
  "text.autoconfig.farlandsprobe.category.encoding": "坐标编码",
  "text.autoconfig.farlandsprobe.category.stability": "远地稳定性修复",
  "text.autoconfig.farlandsprobe.option.lighting.fullBright": "无黑暗（全局最高亮度）",
  "text.autoconfig.farlandsprobe.option.lighting.fullBright.@Tooltip": "强制所有方块与实体亮度为最高（15），并取消黑暗效果雾。",
  "text.autoconfig.farlandsprobe.option.border.removeWorldBorder": "移除世界边境",
  "text.autoconfig.farlandsprobe.option.border.removeWorldBorder.@Tooltip": "移除自带的世界边境：碰撞墙、伤害、红色警戒边框与位置钳制全部禁用。",
  "text.autoconfig.farlandsprobe.option.border.disableMovementClamps": "禁用 30,000,000 移动钳制",
  "text.autoconfig.farlandsprobe.option.border.disableMovementClamps.@Tooltip": "解除玩家/实体在 ±30,000,000 的隐形墙钳制（Player.tick、absSnapTo、clampHorizontal）。",
  "text.autoconfig.farlandsprobe.option.bounds.relaxSpawnAndTeleportBounds": "放开生成/传送检查",
  "text.autoconfig.farlandsprobe.option.bounds.relaxSpawnAndTeleportBounds.@Tooltip": "允许在世界任意坐标生成、传送、交互与高度查询（Level 边界检查全部放行）。",
  "text.autoconfig.farlandsprobe.option.bounds.allowChunkGenerationEverywhere": "允许任意坐标生成区块",
  "text.autoconfig.farlandsprobe.option.bounds.allowChunkGenerationEverywhere.@Tooltip": "解除区块合法性检查，使生成可以越过 ±33,553,360 方块继续推进。",
  "text.autoconfig.farlandsprobe.option.encoding.extendSectionEncoding": "扩展区块坐标编码（28/8/28）",
  "text.autoconfig.farlandsprobe.option.encoding.extendSectionEncoding.@Tooltip": "将区块坐标打包扩展到 int32 极限，让渲染/生成上限推到 ±2,147,483,632 方块。",
  "text.autoconfig.farlandsprobe.option.stability.guardHugeMoveDelta": "阻止超大移动增量卡死",
  "text.autoconfig.farlandsprobe.option.stability.guardHugeMoveDelta.@Tooltip": "坐标编码回绕产生超大移动增量时，跳过碰撞直接 setPos，防止服务器线程挂起。",
  "text.autoconfig.farlandsprobe.option.stability.fixEntitySectionOverflow": "修复实体区块范围溢出",
  "text.autoconfig.farlandsprobe.option.stability.fixEntitySectionOverflow.@Tooltip": "实体区块范围查找的 long 溢出崩溃防护。",
  "text.autoconfig.farlandsprobe.option.stability.fixLightSectionCrash": "修复光照缺失区块崩溃",
  "text.autoconfig.farlandsprobe.option.stability.fixLightSectionCrash.@Tooltip": "光照引擎遇到缺失区块时的 NPE 防护。",
  "text.autoconfig.farlandsprobe.option.stability.fixMineshaftOverflow": "修复矿井坐标溢出",
  "text.autoconfig.farlandsprobe.option.stability.fixMineshaftOverflow.@Tooltip": "矿井走廊中点 int 溢出修复（x0+(x1-x0)/2）。",
  "text.autoconfig.farlandsprobe.option.stability.fixAquiferOverflow": "防御 aquifer 网格 OOM",
  "text.autoconfig.farlandsprobe.option.stability.fixAquiferOverflow.@Tooltip": "aquifer 网格尺寸异常时禁用 aquifer，避免巨大数组分配导致的 OOM。",
  "text.autoconfig.farlandsprobe.option.stability.fixOctreeOverflow": "修复渲染八叉树溢出",
  "text.autoconfig.farlandsprobe.option.stability.fixOctreeOverflow.@Tooltip": "渲染八叉树边界在 ±2^31 附近溢出导致方块停止渲染的修复。",
  "text.autoconfig.farlandsprobe.option.stability.disableStructuresFarOut": "极远坐标禁用结构生成",
  "text.autoconfig.farlandsprobe.option.stability.disableStructuresFarOut.@Tooltip": "chunk 坐标超过 ±63,000,000 时跳过结构生成，避免结构坐标溢出引发 OOM。"
}
